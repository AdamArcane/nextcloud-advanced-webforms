{
  "name": "adamarcane/nextcloud-advanced-forms",
  "description": "Advanced forms app for Nextcloud",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "lint": "find lib -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test:unit": "phpunit --display-all-issues -c tests/phpunit.xml"
  },
  "autoload": {
    "psr-4": {
      "OCA\\Webforms\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Webforms\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  }
}
